# Names of the secrets GrokBot needs. Copy to `.env` and fill in there.
# `.env` is gitignored. NEVER put real values in this file or anywhere else in the repo.

# DeepSeek model API (the user's key). Set a monthly spend cap on the account.
DEEPSEEK_API_KEY=

# Only if you switch models away from DeepSeek; leave blank otherwise.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Telegram bot, from @BotFather. The user creates the bot.
TELEGRAM_BOT_TOKEN=

# Google OAuth client for Gmail, Calendar and Tasks (scopes in docs/PLAN.md).
# Prefer mounting the client-secret JSON on the server; these are for the
# alternative where the values are passed as environment variables.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
