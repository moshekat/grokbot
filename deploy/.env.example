# Environment for Hermes on the ai-assistant VM. Copy to the server as
# /srv/hermes/.env (mode 600) and fill in there. NEVER commit real values.
#
# Hermes reads this file through its data volume: - ~/.hermes:/opt/data
# Server values go in ~/.hermes/.env; the shell that runs docker needs the rest.
#
# Pinned image tag. Bump deliberately after reading the release notes.
HERMES_IMAGE=nousresearch/hermes-agent:v0.22.2

# Host user that owns ~/.hermes (so files stay readable on the host).
# Run `id -u` and `id -g` on the VM and paste the numbers.
HERMES_UID=1000
HERMES_GID=1000

# DeepSeek (provider name: deepseek). Base URL https://api.deepseek.com,
# model deepseek-flash. Set the same values with `hermes setup` or `hermes model`.
DEEPSEEK_API_KEY=

# Telegram bot from @BotFather, and the numeric Telegram user id(s) allowed to talk to it.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=

# Off by default. Enabling the HTTP API server requires API_SERVER_KEY and
# should only be done behind the VPN. See docs/HANDOVER.md.
# API_SERVER_HOST=
# API_SERVER_KEY=
